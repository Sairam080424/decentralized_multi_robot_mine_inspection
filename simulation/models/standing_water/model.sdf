<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="standing_water">
    <static>true</static>
    <link name="water_surface">
      <pose>0 0 0.008 0 0 0</pose>
      <!-- Low-friction surface representing wet puddle -->
      <collision name="col">
        <geometry>
          <box>
            <size>3.5 2.5 0.015</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.3</mu>
              <mu2>0.25</mu2>
              <slip1>0.2</slip1>
              <slip2>0.2</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="vis">
        <geometry>
          <box>
            <size>3.5 2.5 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.14 0.18 0.85</ambient>
          <diffuse>0.12 0.22 0.28 0.85</diffuse>
          <specular>0.8 0.8 0.9 1.0</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
